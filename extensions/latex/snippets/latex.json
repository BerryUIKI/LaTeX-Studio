{
	"Document Template (article)": {
		"prefix": "doc",
		"body": [
			"\\documentclass[11pt,a4paper]{article}",
			"\\usepackage[utf8]{inputenc}",
			"\\usepackage{amsmath,amssymb,amsfonts}",
			"\\usepackage{graphicx}",
			"\\usepackage{hyperref}",
			"",
			"\\title{${1:Document Title}}",
			"\\author{${2:Author Name}}",
			"\\date{\\today}",
			"",
			"\\begin{document}",
			"",
			"\\maketitle",
			"",
			"\\begin{abstract}",
			"\t${3:Abstract text goes here...}",
			"\\end{abstract}",
			"",
			"\\section{${4:Introduction}}",
			"${0}",
			"",
			"\\bibliographystyle{plain}",
			"\\bibliography{${5:references}}",
			"",
			"\\end{document}"
		],
		"description": "Standard LaTeX article skeleton"
	},
	"Document Template (ctexart Chinese)": {
		"prefix": "doc-cn",
		"body": [
			"\\documentclass[UTF8,12pt,a4paper]{ctexart}",
			"\\usepackage{amsmath,amssymb,amsfonts}",
			"\\usepackage{graphicx}",
			"\\usepackage{geometry}",
			"\\geometry{left=2.5cm,right=2.5cm,top=2.5cm,bottom=2.5cm}",
			"\\usepackage{hyperref}",
			"",
			"\\title{${1:文档标题}}",
			"\\author{${2:作者姓名}}",
			"\\date{\\today}",
			"",
			"\\begin{document}",
			"",
			"\\maketitle",
			"",
			"\\begin{abstract}",
			"\t${3:摘要内容...}",
			"\\end{abstract}",
			"",
			"\\section{${4:引言}}",
			"${0}",
			"",
			"\\end{document}"
		],
		"description": "Chinese article skeleton using ctexart"
	},
	"Generic Environment": {
		"prefix": "begin",
		"body": [
			"\\begin{${1:environment}}",
			"\t${0}",
			"\\end{${1:environment}}"
		],
		"description": "Insert generic \\begin{env} ... \\end{env}"
	},
	"Equation": {
		"prefix": "eq",
		"body": [
			"\\begin{equation}",
			"\t\\label{eq:${1:label}}",
			"\t${0}",
			"\\end{equation}"
		],
		"description": "Numbered equation environment"
	},
	"Equation Unnumbered": {
		"prefix": "eq*",
		"body": [
			"\\begin{equation*}",
			"\t${0}",
			"\\end{equation*}"
		],
		"description": "Unnumbered equation environment"
	},
	"Align Equations": {
		"prefix": "align",
		"body": [
			"\\begin{align}",
			"\t\\label{eq:${1:label}}",
			"\t${2:lhs} &= ${0:rhs} \\\\",
			"\\end{align}"
		],
		"description": "Aligned multi-line equations"
	},
	"Figure": {
		"prefix": "fig",
		"body": [
			"\\begin{figure}[${1:htbp}]",
			"\t\\centering",
			"\t\\includegraphics[width=${2:0.8}\\linewidth]{${3:image_path}}",
			"\t\\caption{${4:Caption text}}",
			"\t\\label{fig:${5:label}}",
			"\\end{figure}",
			"${0}"
		],
		"description": "Insert figure with graphic, caption, and label"
	},
	"Table": {
		"prefix": "tab",
		"body": [
			"\\begin{table}[${1:htbp}]",
			"\t\\centering",
			"\t\\caption{${2:Caption text}}",
			"\t\\label{tab:${3:label}}",
			"\t\\begin{tabular}{${4:c c c}}",
			"\t\t\\hline",
			"\t\t${5:Header 1} & ${6:Header 2} & ${7:Header 3} \\\\",
			"\t\t\\hline",
			"\t\t${8:Row 1} & ${9:Value 1} & ${10:Value 2} \\\\",
			"\t\t\\hline",
			"\t\\end{tabular}",
			"\\end{table}",
			"${0}"
		],
		"description": "Insert table environment"
	},
	"Itemize List": {
		"prefix": "item",
		"body": [
			"\\begin{itemize}",
			"\t\\item ${0}",
			"\\end{itemize}"
		],
		"description": "Bulleted list environment"
	},
	"Enumerate List": {
		"prefix": "enum",
		"body": [
			"\\begin{enumerate}",
			"\t\\item ${0}",
			"\\end{enumerate}"
		],
		"description": "Numbered list environment"
	},
	"Section": {
		"prefix": "sec",
		"body": [
			"\\section{${1:Section Title}}",
			"\\label{sec:${2:label}}",
			"${0}"
		],
		"description": "Section header with label"
	},
	"Subsection": {
		"prefix": "subsec",
		"body": [
			"\\subsection{${1:Subsection Title}}",
			"\\label{subsec:${2:label}}",
			"${0}"
		],
		"description": "Subsection header with label"
	},
	"Subsubsection": {
		"prefix": "subsubsec",
		"body": [
			"\\subsubsection{${1:Subsubsection Title}}",
			"\\label{subsubsec:${2:label}}",
			"${0}"
		],
		"description": "Subsubsection header with label"
	},
	"Fraction": {
		"prefix": "frac",
		"body": "\\frac{${1:num}}{${2:denom}}${0}",
		"description": "Fraction \\frac{a}{b}"
	},
	"Summation": {
		"prefix": "sum",
		"body": "\\sum_{${1:i=1}}^{${2:n}} ${0}",
		"description": "Summation \\sum_{i=1}^{n}"
	},
	"Integral": {
		"prefix": "int",
		"body": "\\int_{${1:-\\infty}}^{${2:\\infty}} ${3:f(x)} \\, \\mathrm{d}${4:x} ${0}",
		"description": "Definite integral \\int"
	},
	"Matrix (bmatrix)": {
		"prefix": "bmatrix",
		"body": [
			"\\begin{bmatrix}",
			"\t${1:a_{11}} & ${2:a_{12}} \\\\",
			"\t${3:a_{21}} & ${4:a_{22}}",
			"\\end{bmatrix}${0}"
		],
		"description": "Bracketed matrix [ ... ]"
	},
	"Matrix (pmatrix)": {
		"prefix": "pmatrix",
		"body": [
			"\\begin{pmatrix}",
			"\t${1:a_{11}} & ${2:a_{12}} \\\\",
			"\t${3:a_{21}} & ${4:a_{22}}",
			"\\end{pmatrix}${0}"
		],
		"description": "Parenthesized matrix ( ... )"
	},
	"Citation": {
		"prefix": "cite",
		"body": "\\cite{${1:key}}${0}",
		"description": "Citation reference"
	},
	"Reference": {
		"prefix": "ref",
		"body": "\\ref{${1:label}}${0}",
		"description": "Cross-reference label"
	},
	"Equation Reference": {
		"prefix": "eqref",
		"body": "\\eqref{eq:${1:label}}${0}",
		"description": "Equation cross-reference \\eqref{...}"
	}
}
