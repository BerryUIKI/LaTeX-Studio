{
  "name": "latex",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "10.0.0",
  "publisher": "vscode",
  "license": "MIT",
  "engines": {
    "vscode": "*"
  },
  "scripts": {
    "update-grammar": "node ./build/update-grammars.js"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:latex",
    "onLanguage:tex"
  ],
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "tex",
        "aliases": [
          "TeX",
          "tex"
        ],
        "extensions": [
          ".sty",
          ".cls",
          ".bbx",
          ".cbx"
        ],
        "configuration": "latex-language-configuration.json"
      },
      {
        "id": "latex",
        "aliases": [
          "LaTeX",
          "latex"
        ],
        "extensions": [
          ".tex",
          ".ltx",
          ".ctx"
        ],
        "configuration": "latex-language-configuration.json"
      },
      {
        "id": "bibtex",
        "aliases": [
          "BibTeX",
          "bibtex"
        ],
        "extensions": [
          ".bib"
        ]
      },
      {
        "id": "cpp_embedded_latex",
        "configuration": "latex-cpp-embedded-language-configuration.json",
        "aliases": []
      },
      {
        "id": "markdown_latex_combined",
        "configuration": "markdown-latex-combined-language-configuration.json",
        "aliases": []
      }
    ],
    "grammars": [
      {
        "language": "tex",
        "scopeName": "text.tex",
        "path": "./syntaxes/TeX.tmLanguage.json",
        "unbalancedBracketScopes": [
          "keyword.control.ifnextchar.tex",
          "punctuation.math.operator.tex"
        ]
      },
      {
        "language": "latex",
        "scopeName": "text.tex.latex",
        "path": "./syntaxes/LaTeX.tmLanguage.json",
        "unbalancedBracketScopes": [
          "keyword.control.ifnextchar.tex",
          "punctuation.math.operator.tex"
        ],
        "embeddedLanguages": {
          "source.cpp": "cpp_embedded_latex",
          "source.css": "css",
          "text.html": "html",
          "source.java": "java",
          "source.js": "javascript",
          "source.julia": "julia",
          "source.lua": "lua",
          "source.python": "python",
          "source.ruby": "ruby",
          "source.ts": "typescript",
          "text.xml": "xml",
          "source.yaml": "yaml",
          "meta.embedded.markdown_latex_combined": "markdown_latex_combined"
        }
      },
      {
        "language": "bibtex",
        "scopeName": "text.bibtex",
        "path": "./syntaxes/Bibtex.tmLanguage.json"
      },
      {
        "language": "markdown_latex_combined",
        "scopeName": "text.tex.markdown_latex_combined",
        "path": "./syntaxes/markdown-latex-combined.tmLanguage.json"
      },
      {
        "language": "cpp_embedded_latex",
        "scopeName": "source.cpp.embedded.latex",
        "path": "./syntaxes/cpp-grammar-bailout.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "latex",
        "path": "./snippets/latex.json"
      },
      {
        "language": "tex",
        "path": "./snippets/latex.json"
      }
    ],
    "configurationDefaults": {
      "[latex]": {
        "editor.wordWrap": "on",
        "editor.quickSuggestions": {
          "other": "inline",
          "comments": "off",
          "strings": "off"
        },
        "editor.suggest.snippetsPreventQuickSuggestions": false,
        "editor.bracketPairColorization.enabled": true,
        "editor.guides.bracketPairs": "active"
      },
      "[tex]": {
        "editor.wordWrap": "on",
        "editor.bracketPairColorization.enabled": true
      },
      "[bibtex]": {
        "editor.wordWrap": "off"
      }
    },
    "commands": [
      {
        "command": "latex-studio.viewPdf",
        "title": "LaTeX Studio: View PDF Preview",
        "icon": "$(file-pdf)"
      },
      {
        "command": "latex-studio.synctex",
        "title": "LaTeX Studio: SyncTeX Forward Search",
        "icon": "$(arrow-right)"
      },
      {
        "command": "latex-studio.build",
        "title": "LaTeX Studio: Build LaTeX Document",
        "icon": "$(play)"
      },
      {
        "command": "latex-studio.clean",
        "title": "LaTeX Studio: Clean Auxiliary Files",
        "icon": "$(trash)"
      },
      {
        "command": "latex-studio.selectRecipe",
        "title": "LaTeX Studio: Select Compiler Recipe",
        "icon": "$(gear)"
      },
      {
        "command": "latex-studio.checkEnvironment",
        "title": "LaTeX Studio: Check TeX Environment",
        "icon": "$(check)"
      },
      {
        "command": "latex-studio.cancelBuild",
        "title": "LaTeX Studio: Cancel Current Build",
        "icon": "$(stop)"
      },
      {
        "command": "latex-studio.insertSnippet",
        "title": "LaTeX Studio: Insert Math Symbol"
      },
      {
        "command": "latex-studio.jumpToLine",
        "title": "LaTeX Studio: Jump to Document Line"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "latex-studio.viewPdf",
          "when": "resourceExtname == .tex || resourceExtname == .ltx",
          "group": "navigation@1"
        },
        {
          "command": "latex-studio.build",
          "when": "resourceExtname == .tex || resourceExtname == .ltx",
          "group": "navigation@2"
        },
        {
          "command": "latex-studio.clean",
          "when": "resourceExtname == .tex || resourceExtname == .ltx",
          "group": "navigation@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "latex-studio.viewPdf",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "editorLangId == latex || editorLangId == tex"
      },
      {
        "command": "latex-studio.synctex",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j",
        "when": "editorLangId == latex || editorLangId == tex"
      },
      {
        "command": "latex-studio.build",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "editorLangId == latex || editorLangId == tex"
      },
      {
        "command": "latex-studio.clean",
        "key": "ctrl+alt+c",
        "when": "editorLangId == latex || editorLangId == tex"
      }
    ],
    "configuration": {
      "title": "LaTeX Studio",
      "properties": {
        "latex-studio.view.autoOpenPdf": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open or refresh the PDF preview when build succeeds."
        },
        "latex-studio.build.autoBuild": {
          "type": "string",
          "enum": [
            "never",
            "onSave"
          ],
          "default": "onSave",
          "description": "Automatically trigger LaTeX compilation when saving a document."
        },
        "latex-studio.build.recipe": {
          "type": "string",
          "default": "xelatex",
          "description": "Default LaTeX compiler recipe (e.g. xelatex, pdflatex, latexmk)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "latex-studio-sidebar",
          "title": "LaTeX Studio",
          "icon": "$(book)"
        }
      ]
    },
    "views": {
      "latex-studio-sidebar": [
        {
          "id": "latex-studio.actions",
          "name": "Quick Actions (快捷操作)"
        },
        {
          "id": "latex-studio.outline",
          "name": "Document Outline (文档大纲)"
        },
        {
          "id": "latex-studio.symbols",
          "name": "Math Symbols Palette (数学符号拾取器)"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BerryUIKI/LaTeX-Studio.git"
  }
}
